#!/bin/sh
# Refresh caches after removal. User data in ~/.config/mp3-tagger is never touched.
set -e

if [ -x /usr/bin/update-desktop-database ]; then
    update-desktop-database -q /usr/share/applications || true
fi
if [ -x /usr/bin/gtk-update-icon-cache ]; then
    gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
elif [ -x /usr/bin/update-icon-cache ]; then
    update-icon-cache -q -f /usr/share/icons/hicolor || true
fi

if [ "$1" = "purge" ]; then
    rmdir -p /usr/share/icons/hicolor/16x16/apps 2>/dev/null || true
fi

exit 0

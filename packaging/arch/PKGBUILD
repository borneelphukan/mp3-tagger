# Maintainer: borneelphukan <borneelphukan@users.noreply.github.com>
#
# Packages a prebuilt xur-porisoy binary. PKGVER, BINARY and ROOT are supplied by
# packaging/arch/build-arch-pkg.sh, which runs makepkg inside an Arch container.

pkgname=xur-porisoy
pkgver=${PKGVER:?PKGVER is required}
pkgrel=1
pkgdesc="MP3 metadata editor with LLM-powered metadata fetching"
arch=('x86_64' 'aarch64')
url="https://github.com/borneelphukan/xur-porisoy"
license=('MIT')
depends=(
    'glibc'
    'gcc-libs'
    'dbus'
    'libglvnd'
    'wayland'
    'libx11'
    'libxcb'
    'libxcursor'
    'libxi'
    'libxkbcommon'
    'libxrender'
)
options=('!strip' '!debug')
source=()
sha256sums=()

package() {
    install -Dm755 "${BINARY:?BINARY is required}" "$pkgdir/usr/bin/xur-porisoy"
    install -Dm644 "$ROOT/packaging/debian/xur-porisoy.desktop" \
        "$pkgdir/usr/share/applications/xur-porisoy.desktop"
    install -Dm644 "$ROOT/packaging/debian/xur-porisoy.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/xur-porisoy.metainfo.xml"
    install -Dm644 "$ROOT/assets/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/xur-porisoy.png"
    install -Dm644 "$ROOT/README.md" "$pkgdir/usr/share/doc/xur-porisoy/README.md"
}
